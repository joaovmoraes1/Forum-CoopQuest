generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  topic
  reply
}

enum EventType {
  Competicao
  Workshop
  Meetup
}

model User {
  id                      Int                      @id @default(autoincrement())
  name                    String
  email                   String                   @unique
  password                String
  avatar                  String?
  phone                   String?
  location                String?
  bio                     String?
  title                   String?                
  createdAt               DateTime                 @default(now())
  lastActivity            DateTime?
  isOnline                Boolean                  @default(false)
  level                   Int                      @default(1) // Novo campo para o nível do usuário
  projects                Int                      @default(0) // Novo campo para o número de projetos
  challengeParticipations ChallengeParticipation[]
  reports                 Report[]                 @relation("ReportUser")
  topics                  Topic[]                  @relation("TopicAuthor")
  replies                 TopicReply[]             @relation("ReplyAuthor")
  eventParticipations     EventParticipation[]     @relation("UserEvents")
  sentMessages            Message[]                @relation("Sender")
  receivedMessages        Message[]                @relation("Recipient")
}

model Topic {
  id           Int          @id @default(autoincrement())
  title        String
  content      String
  category     String       @default("")
  author       String
  authorId     Int
  date         DateTime     @default(now())
  repliesCount Int          @default(0)
  views        Int          @default(0)
  likes        Int          @default(0)
  tags         String[]     @default([])
  reports      Report[]     @relation("TopicReports")
  authorUser   User         @relation("TopicAuthor", fields: [authorId], references: [id])
  replies      TopicReply[] @relation("TopicReplies")
}

model TopicReply {
  id         Int      @id @default(autoincrement())
  topicId    Int
  content    String   @default("")
  author     String
  authorId   Int
  date       DateTime @default(now())
  likes      Int      @default(0)
  reports    Report[] @relation("ReplyReports")
  authorUser User     @relation("ReplyAuthor", fields: [authorId], references: [id])
  topic      Topic    @relation("TopicReplies", fields: [topicId], references: [id])
}

model Report {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation("ReportUser", fields: [userId], references: [id])
  date          DateTime    @default(now())
  contentId     Int
  contentType   ContentType
  reason        String
  reportedTopic Topic?      @relation("TopicReports", fields: [contentId], references: [id], onDelete: Cascade, map: "Report_topic_fkey")
  reportedReply TopicReply? @relation("ReplyReports", fields: [contentId], references: [id], onDelete: Cascade, map: "Report_reply_fkey")
  @@index([contentId])
}

model DailyChallenge {
  id             Int                      @id @default(autoincrement())
  title          String
  description    String
  tips           String
  startDate      DateTime
  endDate        DateTime?
  active         Boolean                  @default(true)
  reward         Int                      @default(0)
  participations ChallengeParticipation[] @relation("ChallengeParticipations")
}

model ChallengeParticipation {
  userId      Int
  challengeId Int
  user        User             @relation(fields: [userId], references: [id])
  challenge   DailyChallenge   @relation("ChallengeParticipations", fields: [challengeId], references: [id])
  progress    Int              @default(0)
  completed   Boolean          @default(false)
  @@id([userId, challengeId])
}

model Event {
  id             Int                   @id @default(autoincrement())
  title          String
  description    String
  date           DateTime
  time           String
  participants   Int                   @default(0)
  type           EventType
  participations EventParticipation[]  @relation("EventParticipants")
}

model EventParticipation {
  userId     Int
  eventId    Int
  user       User    @relation("UserEvents", fields: [userId], references: [id])
  event      Event   @relation("EventParticipants", fields: [eventId], references: [id])
  @@id([userId, eventId])
}

model Message {
  id           Int      @id @default(autoincrement())
  senderId     Int
  recipientId  Int
  content      String
  date         DateTime @default(now())
  sender       User     @relation("Sender", fields: [senderId], references: [id])
  recipient    User     @relation("Recipient", fields: [recipientId], references: [id])
  @@index([senderId])
  @@index([recipientId])
}

model Faq {
  id         Int      @id @default(autoincrement())
  category   String
  question   String
  answer     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Tutorial {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  link        String
  icon        String?  // Store icon name or path if needed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}